# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data files (too large for git)
data/*.csv
data/*.zip
data_cleaned/*.csv

# Secrets
.env

# Node (OpenClaw)
node_modules/
openclaw/.openclaw/

# OpenClaw project-local state (OPENCLAW_HOME) — sessions, credentials, gateway token
/.openclaw/
*.bak
openclaw/openclaw.json.bak*
openclaw/openclaw.json.last-good

# OpenClaw auto-generated workspace/runtime files (regenerated on startup)
openclaw/AGENTS.md
openclaw/HEARTBEAT.md
openclaw/IDENTITY.md
openclaw/TOOLS.md
openclaw/USER.md
openclaw/media/

# OpenClaw config schema dump (machine-generated)
schema.json

# Runtime logs
/logs/

# Logs
openclaw/logs/*.log

# Generated charts / exports / agent temp data
/tmp/*.png
openclaw/charts/
openclaw/exports/
openclaw/tmp_*.json

# ChromaDB vector store (local data, not committed)
chroma_db/

.claude/